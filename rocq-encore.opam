# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Extraction of Rocq programs to the Encore VM"
description:
  "Extraction directives mapping nat, its operations, byte strings and host externs onto Encore VM values and primitives. Import Encore.Extraction.ExtrEncore before extracting to Scheme, then compile the .scm with `encore compile scheme`."
license: "Apache-2.0"
homepage: "https://github.com/vbergeron/encore"
bug-reports: "https://github.com/vbergeron/encore/issues"
depends: [
  "dune" {>= "3.21" & >= "3.21"}
  "rocq-core" {>= "9.1" & < "9.2"}
  "rocq-stdlib" {>= "9.1" & < "9.2"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/vbergeron/encore.git"
x-maintenance-intent: ["(latest)"]
