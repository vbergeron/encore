# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Encore compiler passes written in Rocq"
description:
  "The Encore IRs (ds, dsi, cps, asm) as Rocq data types, with their S-expression text forms and the compiler passes between them, extracted to OCaml. The encore-passes command reads IR text from one pipeline stage and writes the IR of a later stage."
license: "Apache-2.0"
homepage: "https://github.com/vbergeron/encore"
bug-reports: "https://github.com/vbergeron/encore/issues"
depends: [
  "dune" {>= "3.21" & >= "3.21"}
  "ocaml" {>= "4.14"}
  "rocq-core" {>= "9.1" & < "9.2"}
  "rocq-stdlib" {>= "9.1" & < "9.2"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/vbergeron/encore.git"
x-maintenance-intent: ["(latest)"]
